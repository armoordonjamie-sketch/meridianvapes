# =============================================================================
# Meridian Vapes - repository ignore rules
# =============================================================================

# --- Secrets (never commit) --------------------------------------------------
# Real environment files are gitignored. Only *.example placeholders are tracked.
.env
.env.*
!.env.example
!.env.*.example

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / frontend ---------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local

# --- Databases ---------------------------------------------------------------
*.sqlite3
*.sqlite
*.db

# --- Backups -----------------------------------------------------------------
backups/
*.sql
*.sql.gz
*.dump

# --- Logs --------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Editor / OS -------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
# Office lock / temp files
~$*
