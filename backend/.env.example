# =============================================================================
# Meridian Vapes API - environment configuration
#
# Copy this file to `.env` in the backend directory and fill in real values.
# The .env file is gitignored and must never be committed. This .env.example
# carries placeholders only, never real secrets.
# =============================================================================

# --- InvenTree connection (localhost only, never exposed publicly) -----------
# The FastAPI service talks to InvenTree over localhost. Use the loopback bound
# address and port of your InvenTree container.
INVENTREE_URL="http://127.0.0.1:8080"
# Token from InvenTree (Settings > API tokens, or /api/user/token/). Placeholder
# only. Generate a real token on the server and keep it out of git.
INVENTREE_TOKEN="replace-with-a-real-inventree-token"

# --- HTTP / cache behaviour --------------------------------------------------
REQUEST_TIMEOUT_SECONDS=10
CACHE_TTL_SECONDS=60

# --- CORS --------------------------------------------------------------------
# Comma separated allowed origins. Meridian production domains only, no wildcard.
CORS_ORIGINS="https://meridianvapes.co.uk,https://www.meridianvapes.co.uk"

# --- InvenTree part parameter template names ---------------------------------
# The public product shape is built from InvenTree parts plus these custom part
# parameters. Rename here if your InvenTree templates use different names.
# Matching is case insensitive.
PARAM_MHRA_NOTIFIED="mhra_notified"
PARAM_IS_DISPOSABLE="is_disposable"
PARAM_PRICE_GBP="price_gbp"
PARAM_SLUG="slug"
PARAM_IMAGE_URL="image_url"
PARAM_CATEGORY="category"

# --- Logging -----------------------------------------------------------------
LOG_LEVEL="INFO"
