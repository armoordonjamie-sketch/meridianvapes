# =============================================================================
# Meridian Vapes — environment configuration
# Copy this file to `.env` and fill in real values. Only variables prefixed
# with VITE_ are exposed to the client bundle (Vite convention).
# Never put secret API keys here — those live in the FastAPI backend.
# =============================================================================

# --- Public site / SEO -------------------------------------------------------
VITE_SITE_URL="https://www.meridianvapes.co.uk"
VITE_SITE_NAME="Meridian Vapes"

# --- Company / NAP (Name, Address, Phone) — shown in footer + JSON-LD --------
VITE_COMPANY_LEGAL_NAME="Meridian Vapes Ltd"
VITE_COMPANY_NUMBER="00000000"
VITE_VAT_NUMBER="GB 000 0000 00"
VITE_CONTACT_EMAIL="hello@meridianvapes.co.uk"
VITE_CONTACT_PHONE="+44 20 0000 0000"
VITE_ADDRESS_STREET="1 Example Street"
VITE_ADDRESS_LOCALITY="Eltham"
VITE_ADDRESS_REGION="London"
VITE_ADDRESS_POSTCODE="SE9 0AA"
VITE_ADDRESS_COUNTRY="GB"

# --- Backend API (FastAPI) — leave blank to use the in-repo mock catalogue ---
# When set, src/lib/catalogue/api.ts will fetch from this base URL instead.
VITE_API_BASE_URL=""

# --- Payments (high-risk gateway, wired later) -------------------------------
# Provider key is read by the backend; the front-end only needs a public id.
VITE_PAYMENTS_PROVIDER="stub"          # stub | <provider-name>
VITE_PAYMENTS_PUBLIC_KEY=""

# --- Age verification provider (wired later) ---------------------------------
VITE_AGE_PROVIDER="stub"               # stub | 1account | agechecked
VITE_AGE_PROVIDER_PUBLIC_KEY=""

# --- Analytics: GA4 placeholder ONLY (no ad pixels) --------------------------
# Leave blank to disable. No Google Ads / Meta pixels are included by design.
VITE_GA4_MEASUREMENT_ID=""
