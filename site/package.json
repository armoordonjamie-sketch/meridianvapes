{
  "name": "meridian-vapes-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Marketing + e-commerce front-end for Meridian Vapes — age-verified local vape delivery in Eltham & South East London.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite-react-ssg build && node scripts/generate-sitemap.mjs",
    "product-images": "node scripts/download-product-images.mjs && node scripts/hero-product-cutouts.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "sitemap": "node scripts/generate-sitemap.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-react-ssg": "0.8.9"
  }
}
